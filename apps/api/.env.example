HOST=0.0.0.0
PORT=8080
RUST_LOG=info
TURSO_DATABASE_URL=turso::memory:
TURSO_AUTH_TOKEN=
TURSO_LOCAL_PATH=data/voidreg.db
# Schema: cargo migrate
# Schema + seed if empty: cargo migrate -- --seed
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174
RESEND_API_KEY=
RESEND_DOMAIN=mail.example.com
RESEND_FROM_USER=form
CONTACT_TO_EMAIL=admin@example.com
# Contact form. Leave both empty to keep the form closed. Generate each with `openssl rand -hex 32`.
# CONTACT_FORM_SECRET signs the short-lived form tokens. CONTACT_FORWARD_TOKEN lets only the web
# app call the contact routes (it is passed to the web container by compose).
CONTACT_FORM_SECRET=
CONTACT_FORWARD_TOKEN=

# Admin publishing (set ADMIN_PASSWORD for dev, or an argon2 PHC hash for prod)
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_TTL_HOURS=72

# Public origin used for OAuth redirect URIs and the blog sitemap
PUBLIC_BASE_URL=http://127.0.0.1:8080

# Commenter OAuth (optional; comments stay anonymous when unset).
# Register these redirect URIs with each provider:
#   GitHub OAuth app:   ${PUBLIC_BASE_URL}/api/v1/auth/github/callback
#   Google OAuth client: ${PUBLIC_BASE_URL}/api/v1/auth/google/callback  (scopes: openid email profile)
# GitHub and Google sign-ins that share a verified email join one commenter profile.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
COMMENTER_REDIRECT_URL=
# How long a commenter stays signed in (hours, default 720 = 30 days). Admin sessions use
# ADMIN_SESSION_TTL_HOURS above.
COMMENTER_SESSION_TTL_HOURS=720
# Extra hosts the avatar proxy may fetch photos from, comma separated. GitHub and Google
# photo hosts are always allowed; leave this empty in production.
AVATAR_HOSTS=
# Salt for comment rate-limit keys; change in production
# Required stable secret. Retain the current value across deployments.
COMMENT_IP_SALT=

# Password login is disabled by default. Enable only for local development.
ADMIN_PASSWORD_ENABLED=false
# Comma-separated immutable provider account IDs, never usernames or emails.
ADMIN_GITHUB_IDS=
ADMIN_GOOGLE_SUBJECTS=

# Trust only your reverse proxy's peer address or explicit CIDR. Empty means ignore forwarding headers.
TRUSTED_PROXY_CIDRS=
# Durable comment admission limits. All values must be 1-10000.
COMMENT_ANON_HOURLY=5
COMMENT_ANON_ARTICLE_HOURLY=2
COMMENT_USER_HOURLY=60
COMMENT_USER_ARTICLE_HOURLY=30
COMMENT_BURST=3

# Shared secret for the internal server publishing worker.
COMPILER_TOKEN=
COMPILER_URL=http://127.0.0.1:18084

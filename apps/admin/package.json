{
  "name": "voidreg-admin",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 5174",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "mcp:dev": "tsx mcp/index.ts",
    "mcp:build": "esbuild mcp/index.ts --bundle --platform=node --format=esm --packages=external --external:*.svelte --outfile=dist-mcp/server.mjs",
    "mcp:check": "tsc -p mcp/tsconfig.json",
    "mcp:test": "tsx --test --test-concurrency=1 mcp/*.test.ts",
    "publishing:build": "esbuild publishing/server.ts --bundle --platform=node --format=esm --packages=external --external:*.svelte --outfile=dist-publishing/server.mjs",
    "publishing:dev": "tsx publishing/server.ts",
    "publishing:check": "tsc -p publishing/tsconfig.json",
    "publishing:test": "node publishing/smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22",
    "esbuild": "^0.28.2",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "jiti": "^2.7.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@publisle/adapter-core": "file:vendor/publisle-adapter-core-0.1.1.tgz",
    "@publisle/adapter-svelte": "file:vendor/publisle-adapter-svelte-0.1.1.tgz",
    "@publisle/block-sdk": "file:vendor/publisle-block-sdk-0.1.1.tgz",
    "@publisle/blocks-core": "file:vendor/publisle-blocks-core-0.1.1.tgz",
    "@publisle/blocks-technical": "file:vendor/publisle-blocks-technical-0.1.1.tgz",
    "@publisle/contracts": "file:vendor/publisle-contracts-0.1.1.tgz",
    "@publisle/core": "file:vendor/publisle-core-0.1.1.tgz",
    "@publisle/markdown": "file:vendor/publisle-markdown-0.1.1.tgz",
    "@publisle/playground": "file:vendor/publisle-playground-0.2.1.tgz",
    "@publisle/profiles": "file:vendor/publisle-profiles-0.1.1.tgz",
    "@publisle/schema": "file:vendor/publisle-schema-0.1.0.tgz",
    "dompurify": "^3.3.0",
    "katex": "0.16.47",
    "mermaid": "12.2.0",
    "playwright-core": "1.58.2",
    "wavedrom": "3.5.0",
    "zod": "^4.6.7"
  }
